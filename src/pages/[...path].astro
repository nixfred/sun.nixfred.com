---
// Institutional article template. Renders every entry of the pages
// collection at the route matching its file id. Explicit .astro routes
// take priority over this catch-all, so it only serves what nothing
// else claims.
import { getCollection, render } from 'astro:content';
import Shell from '../layouts/Shell.astro';
import ShareSheet from '../components/ShareSheet.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((page) => ({
    params: { path: page.id },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<Shell
  title={`${page.data.title} · Solar Save Foundation`}
  description={page.data.description}
  surface="crisis"
>
  <article class="doc">
    <header class="doc-head">
      <p class="eyebrow">{page.data.eyebrow}</p>
      <h1>{page.data.title}</h1>
    </header>

    {page.data.stats && (
      <dl class="doc-stats">
        {page.data.stats.map((s) => (
          <div class="doc-stat">
            <dd class="mono stat-value">{s.value}</dd>
            <dt class="stat-label">{s.label}</dt>
            {s.note && <p class="stat-note">{s.note}</p>}
          </div>
        ))}
      </dl>
    )}

    <div class="prose">
      <Content />
    </div>

    {page.data.pullquote && <blockquote class="pull">{page.data.pullquote}</blockquote>}

    <ShareSheet title={page.data.title} />
    <footer class="doc-cta">
      <a class="btn-gold" href={page.data.ctaHref}>{page.data.ctaLabel}</a>
    </footer>
  </article>
</Shell>

<style>
  .doc {
    max-width: 820px;
    margin: 0 auto;
    padding: var(--space-6) var(--space-4) var(--space-7);
  }

  h1 { font-size: var(--text-3xl); max-width: 20ch; }

  .doc-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-4);
    margin: var(--space-5) 0;
  }

  .doc-stat {
    display: flex;
    flex-direction: column;
    border-top: 2px solid var(--gold-500);
    padding-top: var(--space-2);
  }

  .stat-value {
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    font-weight: 600;
    color: var(--gold-300);
    line-height: 1.1;
    margin: 0;
    order: 1;
  }

  .stat-label { font-size: var(--text-sm); font-weight: 600; margin-top: var(--space-1); order: 2; }
  .stat-note { font-size: var(--text-xs); color: var(--text-faint); margin: var(--space-1) 0 0; order: 3; max-width: none; }

  .prose :global(h2) { font-size: var(--text-xl); margin-top: var(--space-5); }
  .prose :global(p) { color: var(--text-muted); line-height: 1.75; }
  .prose :global(ol) { color: var(--text-muted); line-height: 1.75; padding-left: 1.4rem; }
  .prose :global(li) { margin-bottom: 0.6rem; }
  .prose :global(img) { border-radius: var(--radius-lg); margin: var(--space-4) 0 var(--space-1); }
  .prose :global(em) { color: var(--text-faint); font-size: var(--text-sm); }
  .prose :global(blockquote) {
    border-left: 3px solid var(--gold-500);
    margin: var(--space-4) 0;
    padding-left: var(--space-4);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-style: italic;
    color: var(--text);
  }

  .pull {
    border-left: 3px solid var(--gold-500);
    margin: var(--space-5) 0;
    padding-left: var(--space-4);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-style: italic;
  }

  .doc-cta { margin-top: var(--space-6); }

  .btn-gold {
    display: inline-block;
    background: var(--gold-500);
    color: var(--navy-950);
    font: 700 0.9rem var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    padding: 0.85rem 1.5rem;
    border-radius: var(--radius);
  }

  .btn-gold:hover { background: var(--gold-300); color: var(--navy-950); }
</style>
