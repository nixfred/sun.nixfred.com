---
// Global institutional footer. IA footer architecture, trust marks,
// the Wrong Holdings connection, and the ONE disclaimer line that is
// the only place on the entire site allowed to break character.
import Seal from './Seal.astro';
import { FOOTER_COLUMNS } from '../data/navigation';
import { SITE } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <Seal size={84} />
      <p class="footer-mission">
        The Sun has faithfully served this planet for 4.6 billion years.
        The Foundation exists to ensure that service continues, through
        planning, stewardship, and the sustained courage to hold meetings
        about it.
      </p>
    </div>

    <div class="footer-columns">
      {FOOTER_COLUMNS.map((col) => (
        <div class="footer-col">
          <h2 class="footer-heading mono">{col.heading}</h2>
          <ul>
            {col.items.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="trust-row mono">
      {SITE.trustMarks.map((mark) => (
        <span class="trust-mark">{mark}</span>
      ))}
      <span class="trust-mark">
        <a href={SITE.wrongHoldings.href}>{SITE.wrongHoldings.label}</a>
      </span>
    </div>

    <div class="legal-row">
      <p class="copyright mono">
        © {year} Solar Save Foundation. All rights reserved on behalf of
        the Sun, which has not responded to our licensing outreach.
      </p>
    </div>

    <div class="final-line">
      <p class="disclaimer">{SITE.disclaimer}</p>
      <p class="credit mono">
        {SITE.credit.name} ·
        <a href={SITE.credit.home}>nixfred.com</a> ·
        <a href={SITE.credit.source}>source</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy-950);
    color: #cfd8e6;
    margin-top: var(--space-7);
  }

  .footer-inner {
    max-width: var(--page-wide);
    margin: 0 auto;
    padding: var(--space-6) var(--space-4) var(--space-4);
  }

  .footer-brand {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    margin-bottom: var(--space-6);
    color: #eef1f7;
  }

  .footer-mission {
    max-width: 54ch;
    color: #aab6c9;
    margin: 0;
    font-size: var(--text-sm);
  }

  .footer-columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--space-5) var(--space-4);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid #16233c;
  }

  .footer-heading {
    font-size: var(--text-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-300);
    margin: 0 0 var(--space-3);
  }

  .footer-col ul { list-style: none; margin: 0; padding: 0; }
  .footer-col li { margin-bottom: 0.5rem; }

  .footer-col a {
    color: #cfd8e6;
    text-decoration: none;
    font-size: 0.9rem;
  }

  .footer-col a:hover { color: var(--gold-300); text-decoration: underline; }

  .trust-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem var(--space-4);
    padding: var(--space-4) 0;
    font-size: var(--text-xs);
    color: #7a879c;
    letter-spacing: 0.04em;
  }

  .trust-mark a { color: #7a879c; }
  .trust-mark a:hover { color: var(--gold-300); }

  .legal-row { padding-bottom: var(--space-4); }

  .copyright {
    font-size: var(--text-xs);
    color: #5d6a80;
    margin: 0;
    max-width: none;
  }

  .final-line {
    border-top: 1px solid #16233c;
    padding-top: var(--space-3);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
  }

  .disclaimer,
  .credit {
    font-size: 0.68rem;
    color: #4d5a70;
    margin: 0;
    max-width: none;
  }

  .credit a { color: #4d5a70; }
  .credit a:hover { color: var(--gold-300); }
</style>
