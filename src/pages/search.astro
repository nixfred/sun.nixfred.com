---
// Site search (08_INTERACTIONS). Build time index, client side scoring.
// No libraries, no network beyond loading this page.
import Shell from '../layouts/Shell.astro';
import { getCollection } from 'astro:content';
import { PRIMARY_NAV } from '../data/navigation';

const programs = await getCollection('programs');
const blog = await getCollection('blog');
const press = await getCollection('press');

interface Doc {
  title: string;
  type: string;
  url: string;
  text: string;
}

const INDEX: Doc[] = [
  ...programs.map((p) => ({
    title: p.data.title,
    type: 'Program',
    url: `/programs/${p.id}`,
    text: `${p.data.tagline} ${p.data.summary} ${p.data.milestones.join(' ')}`,
  })),
  ...blog.map((b) => ({
    title: b.data.title,
    type: 'Blog',
    url: `/news/blog/${b.id}`,
    text: `${b.data.category} ${b.data.excerpt} ${b.data.author}`,
  })),
  ...press.map((r) => ({
    title: r.data.title,
    type: 'Press Release',
    url: `/news/press/${r.id}`,
    text: r.data.excerpt,
  })),
  { title: 'Solar Depletion', type: 'Crisis Briefing', url: '/crisis/solar-depletion', text: 'hydrogen loss science red giant depletion principal main sequence planning estimate' },
  { title: 'Impact Dashboard', type: 'Impact', url: '/impact/dashboard', text: 'metrics solar appearances extinction events initiatives meetings dashboard data' },
  { title: 'Emergency Solar Status', type: 'Status', url: '/status', text: 'operational status live monitoring readiness surface conditions confirmation' },
  { title: 'Donate', type: 'Take Action', url: '/donate', text: 'donation commitment monthly allocation give support contribute' },
  ...PRIMARY_NAV.map((s) => ({
    title: s.label,
    type: 'Section',
    url: s.href,
    text: s.items.map((i) => i.label).join(' '),
  })),
];

const typeOptions = [...new Set(INDEX.map((d) => d.type))];
---

<Shell
  title="Search · Save The Sun Foundation"
  description="Search the Foundation's programs, research, news, and institutional resources."
  surface="editorial"
>
  <div class="search-page">
    <header>
      <p class="eyebrow">Search</p>
      <h1>Find what the Foundation has prepared.</h1>
    </header>

    <div class="search-controls">
      <label class="sr-only" for="q">Search query</label>
      <input id="q" type="search" placeholder="Try hydrogen, bucket, or accountability" autocomplete="off" />
      <select id="type-filter" aria-label="Filter by type">
        <option value="">All types</option>
        {typeOptions.map((t) => (
          <option value={t}>{t}</option>
        ))}
      </select>
    </div>

    <p class="mono result-count" id="result-count" aria-live="polite"></p>
    <ol class="results" id="results"></ol>
    <p class="no-results" id="no-results" hidden>
      No results. The Foundation has reviewed your query and scheduled a
      working group on findability.
    </p>
  </div>
</Shell>

<script define:vars={{ INDEX }}>
  const input = document.getElementById('q');
  const typeFilter = document.getElementById('type-filter');
  const list = document.getElementById('results');
  const count = document.getElementById('result-count');
  const empty = document.getElementById('no-results');

  const score = (doc, terms) => {
    const title = doc.title.toLowerCase();
    const text = doc.text.toLowerCase();
    let s = 0;
    for (const t of terms) {
      if (title.includes(t)) s += 5;
      if (text.includes(t)) s += 2;
    }
    return s;
  };

  const run = () => {
    const q = (input?.value ?? '').trim().toLowerCase();
    const type = typeFilter?.value ?? '';
    const terms = q.split(/\s+/).filter(Boolean);

    let docs = INDEX;
    if (type) docs = docs.filter((d) => d.type === type);

    let results;
    if (terms.length === 0) {
      results = q || type ? docs : [];
    } else {
      results = docs
        .map((d) => ({ d, s: score(d, terms) }))
        .filter((r) => r.s > 0)
        .sort((a, b) => b.s - a.s)
        .map((r) => r.d);
    }

    if (list) {
      list.innerHTML = results
        .map(
          (d) => `
        <li class="result">
          <a href="${d.url}">
            <span class="mono result-type">${d.type.toUpperCase()}</span>
            <span class="result-title">${d.title}</span>
          </a>
        </li>`
        )
        .join('');
    }
    if (count) {
      count.textContent = terms.length || type ? `${results.length} RESULT${results.length === 1 ? '' : 'S'}` : '';
    }
    if (empty) empty.hidden = !(terms.length > 0 && results.length === 0);
  };

  input?.addEventListener('input', run);
  typeFilter?.addEventListener('change', run);

  const params = new URLSearchParams(location.search);
  const q = params.get('q');
  if (q && input) {
    input.value = q;
    run();
  }
</script>

<style>
  .search-page {
    max-width: 820px;
    margin: 0 auto;
    padding: var(--space-6) var(--space-4) var(--space-7);
    min-height: 60vh;
  }

  h1 { font-size: var(--text-3xl); max-width: 20ch; }

  .search-controls {
    display: flex;
    gap: var(--space-2);
    margin: var(--space-4) 0;
    flex-wrap: wrap;
  }

  #q {
    flex: 1;
    min-width: 240px;
    font: 400 var(--text-lg) var(--font-sans);
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--gray-200);
    border-radius: var(--radius);
    background: var(--card-bg);
    color: var(--ink);
  }

  #type-filter {
    font: 600 var(--text-sm) var(--font-sans);
    padding: 0 1rem;
    border: 1px solid var(--gray-200);
    border-radius: var(--radius);
    background: var(--card-bg);
    color: var(--ink);
  }

  .result-count {
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    color: var(--gray-500);
    min-height: 1.2em;
  }

  .results { list-style: none; margin: var(--space-3) 0 0; padding: 0; }

  .results :global(.result a) {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: var(--space-3);
    border: 1px solid var(--gray-200);
    border-radius: var(--radius);
    background: var(--card-bg);
    text-decoration: none;
    color: var(--ink);
    margin-bottom: var(--space-2);
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .results :global(.result a:hover) { border-color: var(--gold-500); }

  .results :global(.result-type) {
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    color: var(--gold-700);
  }

  .results :global(.result-title) {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .no-results { color: var(--gray-700); font-style: italic; }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
