---
// Global header with mega menu. Homepage blueprint section 2,
// IA per navigation.ts. Desktop: hover/focus panels enhanced by a
// small click-toggle script. Mobile: accordion panel. No frameworks.
import Seal from './Seal.astro';
import { PRIMARY_NAV } from '../data/navigation';
import { SITE } from '../data/site';
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label={`${SITE.name} home`}>
      <Seal size={46} showRing={false} />
      <span class="brand-text">
        <span class="brand-name">Solar Save</span>
        <span class="brand-sub mono">FOUNDATION</span>
      </span>
    </a>

    <nav class="primary-nav" aria-label="Primary">
      <ul class="nav-list">
        {PRIMARY_NAV.map((section) => (
          <li class="nav-item">
            <button class="nav-trigger" aria-expanded="false" aria-haspopup="true">
              {section.label}
            </button>
            <div class="mega-panel">
              <div class="mega-grid">
                <a class="mega-overview" href={section.href}>
                  {section.label} overview
                </a>
                <ul class="mega-links">
                  {section.items.map((item) => (
                    <li><a href={item.href}>{item.label}</a></li>
                  ))}
                </ul>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <a class="search-link" href="/search" aria-label="Search">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="8.5" cy="8.5" r="6" stroke="currentColor" stroke-width="2"></circle>
          <path d="M13 13 L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
      </a>
      <a class="donate-btn" href="/donate">Donate</a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="mobile-nav" aria-label="Menu">
        <span class="bar"></span><span class="bar"></span><span class="bar"></span>
      </button>
    </div>
  </div>

  <nav class="mobile-nav" id="mobile-nav" aria-label="Primary mobile" hidden>
    <a class="mobile-search" href="/search">
      <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <circle cx="8.5" cy="8.5" r="6" stroke="currentColor" stroke-width="2"></circle>
        <path d="M13 13 L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
      Search the Foundation
    </a>
    {PRIMARY_NAV.map((section) => (
      <details class="mobile-section">
        <summary>{section.label}</summary>
        <ul>
          <li><a href={section.href}>{section.label} overview</a></li>
          {section.items.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </details>
    ))}
    <a class="donate-btn mobile-donate" href="/donate">Donate</a>
  </nav>
</header>

<script>
  // Mega menu with hover intent. Browser review found the pure CSS
  // hover unstable: the pointer crossing between trigger and panel, or
  // wobbling a few pixels diagonally, dropped :hover and slammed the
  // panel shut. JS now owns the open state everywhere: hover opens with
  // a 260ms close grace timer, click toggles, Escape and outside click
  // close, keyboard focus keeps working via focus-within CSS.
  const items = document.querySelectorAll<HTMLLIElement>('.nav-item');
  let closeTimer: number | undefined;
  const hoverCapable = window.matchMedia('(hover: hover)').matches;

  const closeAll = () =>
    items.forEach((i) => {
      i.classList.remove('open');
      i.querySelector('.nav-trigger')?.setAttribute('aria-expanded', 'false');
    });

  const open = (item: HTMLLIElement) => {
    window.clearTimeout(closeTimer);
    closeAll();
    item.classList.add('open');
    item.querySelector('.nav-trigger')?.setAttribute('aria-expanded', 'true');
  };

  items.forEach((item) => {
    const trigger = item.querySelector<HTMLButtonElement>('.nav-trigger');

    trigger?.addEventListener('click', () => {
      const isOpen = item.classList.contains('open');
      closeAll();
      if (!isOpen) open(item);
    });

    if (hoverCapable) {
      // The panel is a DOM child of the li, so entering it keeps us
      // inside the li; the grace timer covers the pixels in between.
      item.addEventListener('mouseenter', () => open(item));
      item.addEventListener('mouseleave', () => {
        window.clearTimeout(closeTimer);
        closeTimer = window.setTimeout(closeAll, 260);
      });
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAll();
  });
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('.nav-item')) closeAll();
  });

  // Shadow only once the header has actually left the top of the page.
  const header = document.querySelector<HTMLElement>('.site-header');
  if (header) {
    const setPinned = () => header.classList.toggle('is-pinned', window.scrollY > 8);
    setPinned();
    document.addEventListener('scroll', setPinned, { passive: true });
  }

  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const mobileNav = document.querySelector<HTMLElement>('.mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (mobileNav) mobileNav.hidden = open;
    document.body.classList.toggle('nav-open', !open);
  });
</script>

<style>
  /* Pinned. The thin status strip above scrolls away, the navigation
     never does. z-index outranks the reading progress bar (60) and the
     sticky article asides. */
  .site-header {
    background: var(--navy-900);
    color: #eef1f7;
    border-bottom: 1px solid #22385c;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  /* Lifts off the page once it is actually pinned, so it reads as
     chrome rather than as part of the content. */
  .site-header.is-pinned {
    box-shadow: 0 10px 30px rgba(3, 8, 18, 0.55);
  }

  .header-inner {
    max-width: var(--page-wide);
    margin: 0 auto;
    padding: 0 var(--space-3);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: 72px;
  }

  @media (min-width: 560px) {
    .header-inner { padding: 0 var(--space-4); gap: var(--space-4); }
  }

  /* min-width:0 lets the brand yield space instead of pushing the
     actions off screen; the 320px audit overflowed by 86px without it. */
  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: #eef1f7;
    min-width: 0;
    flex: 0 1 auto;
  }

  .brand-text { display: flex; flex-direction: column; line-height: 1.05; min-width: 0; }

  .brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.18rem;
    letter-spacing: 0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .brand-sub {
    font-size: 0.58rem;
    letter-spacing: 0.42em;
    color: var(--gold-300);
  }

  /* Desktop nav */
  .primary-nav { display: none; }

  @media (min-width: 1080px) {
    .primary-nav { display: block; }
  }

  .nav-list {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 0.25rem;
    align-items: stretch;
    height: 72px;
  }

  .nav-item {
    display: flex;
  }

  /* Trigger fills the full header height so the hover zone is flush
     with the panel's top edge. No dead pixels between them. */
  .nav-trigger {
    background: none;
    border: 0;
    color: #cfd8e6;
    font: 600 0.86rem var(--font-sans);
    padding: 0 0.65rem;
    display: flex;
    align-items: center;
    cursor: pointer;
    letter-spacing: 0.01em;
  }

  .nav-item:hover .nav-trigger,
  .nav-item.open .nav-trigger,
  .nav-trigger:focus-visible {
    color: var(--gold-300);
    box-shadow: inset 0 -2px 0 var(--gold-500);
  }

  .mega-panel {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: var(--navy-800);
    border-bottom: 2px solid var(--gold-500);
    box-shadow: 0 24px 48px rgba(3, 8, 18, 0.55);
    z-index: 1;
  }

  /* JS owns hover state (.open) so the grace timer works; focus-within
     keeps keyboard navigation panel-capable without JS. */
  .nav-item.open .mega-panel,
  .nav-item:focus-within .mega-panel {
    display: block;
  }

  .mega-grid {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-5) var(--space-4);
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: var(--space-5);
  }

  .mega-overview {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: #eef1f7;
    text-decoration: none;
    border-right: 1px solid #22385c;
    padding-right: var(--space-4);
  }

  .mega-overview:hover { color: var(--gold-300); }

  .mega-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.55rem var(--space-4);
  }

  .mega-links a {
    color: #cfd8e6;
    text-decoration: none;
    font-size: 0.92rem;
  }

  .mega-links a:hover { color: var(--gold-300); text-decoration: underline; }

  /* Actions */
  .header-actions { display: flex; align-items: center; gap: var(--space-3); }

  /* 14x14 on phones before the audit. The icon stays small, the
     hit area does not. */
  .search-link {
    color: #cfd8e6;
    display: none;
    place-items: center;
    width: 44px;
    height: 44px;
  }

  @media (min-width: 560px) {
    .search-link { display: grid; }
  }

  .search-link:hover { color: var(--gold-300); }

  .donate-btn {
    background: var(--gold-500);
    color: var(--navy-950);
    font: 700 0.78rem var(--font-sans);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.7rem 0.85rem;
    border-radius: var(--radius);
    white-space: nowrap;
    display: flex;
    align-items: center;
    min-height: 44px;
    transition: background var(--dur-fast) var(--ease-out);
  }

  @media (min-width: 560px) {
    .donate-btn { font-size: 0.86rem; padding: 0.62rem 1.15rem; }
  }

  .donate-btn:hover { background: var(--gold-300); color: var(--navy-950); }

  /* The most important control on a phone was 32px tall. Now 44. */
  .menu-toggle {
    background: none;
    border: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 4px;
    width: 44px;
    height: 44px;
    padding: 0;
    cursor: pointer;
  }

  .menu-toggle .bar {
    width: 22px;
    height: 2px;
    background: #eef1f7;
  }

  /* Placed after the base rule so it wins the cascade at equal
     specificity. The earlier placement lost and left the hamburger
     visible on desktop, caught in browser review. */
  @media (min-width: 1080px) {
    .menu-toggle { display: none; }
  }

  /* Mobile nav */
  .mobile-nav {
    background: var(--navy-800);
    border-top: 1px solid #22385c;
    padding: var(--space-3) var(--space-4) var(--space-5);
    /* The panel is taller than a phone once sections expand, and the
       header is pinned above it, so it scrolls on its own. */
    max-height: calc(100dvh - var(--header-h));
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  @media (min-width: 1080px) {
    .mobile-nav { display: none !important; }
  }

  .mobile-search {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--gold-300);
    text-decoration: none;
    font: 600 0.95rem var(--font-sans);
    padding: 0.85rem 0;
    border-bottom: 1px solid #22385c;
    min-height: 44px;
  }

  @media (min-width: 560px) {
    .mobile-search { display: none; }
  }

  .mobile-section { border-bottom: 1px solid #22385c; }

  .mobile-section summary {
    font: 600 1rem var(--font-sans);
    color: #eef1f7;
    padding: 0.95rem 0;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    list-style: none;
  }

  .mobile-section summary::after { content: '+'; color: var(--gold-300); }
  .mobile-section[open] summary::after { content: '−'; }

  .mobile-section ul { list-style: none; margin: 0; padding: 0 0 0.9rem; }
  .mobile-section li { padding: 0; }
  .mobile-section li a { display: block; padding: 0.62rem 0; }
  .mobile-section a { color: #cfd8e6; text-decoration: none; }
  .mobile-donate { display: inline-block; margin-top: var(--space-3); }
</style>
