---
// Research overview.
import { getCollection } from 'astro:content';
import Shell from '../../layouts/Shell.astro';

const reports = (await getCollection('reports')).sort((a, b) => b.data.year - a.data.year).slice(0, 3);
---

<Shell
  title="Research · Solar Save Foundation"
  description="The research operation of the Solar Save Foundation. Peer adjacent, methodologically ratified, and freely available."
  surface="crisis"
>
  <div class="research-overview">
    <header class="hero">
      <p class="eyebrow">Research</p>
      <h1>Science, plus the courage to schedule it.</h1>
      <p class="lede">
        The Foundation's research operation reviews the peer reviewed
        literature, confirms that it remains alarming, and publishes the
        confirmation. Our methodology is public, our findings are final,
        and our Scientific Council has never once been surprised by the
        Sun.
      </p>
    </header>

    <section class="featured-reports">
      <h2 class="mono section-label">RECENT PUBLICATIONS</h2>
      <div class="report-row">
        {reports.map((r) => (
          <a class="report-tile" href={`/reports/${r.id}`}>
            <span class="mono tile-type">{r.data.type.toUpperCase()} · {r.data.year}</span>
            <span class="tile-title">{r.data.title}</span>
            <span class="mono tile-pages">{r.data.pages} PAGES</span>
          </a>
        ))}
      </div>
    </section>

    <section class="method">
      <div class="method-inner">
        <h2>How the research operation works.</h2>
        <ol class="method-steps">
          <li>
            <span class="mono step-num">01</span>
            <div>
              <h3>Review the literature</h3>
              <p>
                Our analysts read the peer reviewed work of actual
                astronomers, which is freely available and has been for
                decades. The Foundation contributes no original
                observations and has never claimed to.
              </p>
            </div>
          </li>
          <li>
            <span class="mono step-num">02</span>
            <div>
              <h3>Confirm it remains alarming</h3>
              <p>
                Each finding is assessed against the previous
                assessment. To date every reassessment has agreed with
                the one before it, a consistency the Council regards as
                methodological strength.
              </p>
            </div>
          </li>
          <li>
            <span class="mono step-num">03</span>
            <div>
              <h3>Publish the confirmation</h3>
              <p>
                Findings are issued as numbered documents, read inline on
                this site, and retained in full. Nothing is paywalled,
                because nothing here is worth withholding from a public
                that has to live under the same star.
              </p>
            </div>
          </li>
          <li>
            <span class="mono step-num">04</span>
            <div>
              <h3>Schedule the follow up</h3>
              <p>
                Every publication generates at least one meeting. The
                Foundation considers the meeting the point at which
                research becomes action, and has never required further
                evidence of that.
              </p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section class="standards">
      <div class="standards-inner">
        <h2>What we will and will not say.</h2>
        <div class="standards-grid">
          <div class="standard will">
            <p class="mono standard-label">THE FOUNDATION WILL SAY</p>
            <ul>
              <li>The Sun is consuming finite fuel.</li>
              <li>About five billion years of main sequence hydrogen remain.</li>
              <li>The Sun rose 365 times last year.</li>
              <li>Doing nothing will not save the Sun.</li>
            </ul>
          </div>
          <div class="standard wont">
            <p class="mono standard-label">THE FOUNDATION WILL NOT SAY</p>
            <ul>
              <li>That any contribution extends the Sun's life.</li>
              <li>That a bucket has been built, filled, or lifted.</li>
              <li>That the Sun has responded to our outreach.</li>
              <li>That 4.8 billion years is a scientific measurement.</li>
            </ul>
          </div>
        </div>
        <p class="standards-note">
          The second column is longer than most organizations would
          publish. The Foundation prints it anyway, because a research
          program is defined as much by its restraint as by its findings.
        </p>
      </div>
    </section>

    <section class="paths" data-surface="editorial">
      <div class="paths-inner">
        <h2>Enter the record.</h2>
        <div class="path-links">
          <a href="/research/library">The Research Library, complete and filterable →</a>
          <a href="/documents">The Document Register, every cited document readable inline →</a>
          <a href="/crisis/solar-depletion">The science of solar depletion, briefing one →</a>
          <a href="/news/blog">Analysis and commentary from Foundation staff →</a>
        </div>
      </div>
    </section>
  </div>
</Shell>

<style>
  .hero {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-7) var(--space-4) var(--space-5);
  }

  h1 { font-size: var(--text-3xl); max-width: 22ch; }
  .lede { font-size: var(--text-lg); color: var(--text-muted); max-width: 58ch; }

  .featured-reports {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--space-4) var(--space-6);
  }

  .section-label {
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    color: var(--text-faint);
    margin-bottom: var(--space-3);
  }

  .report-row {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--space-4);
  }

  @media (min-width: 760px) {
    .report-row { grid-template-columns: repeat(3, 1fr); }
  }

  .report-tile {
    background: var(--card-bg);
    border: 1px solid var(--line);
    border-bottom: 3px solid var(--gold-500);
    border-radius: var(--radius);
    padding: var(--space-4);
    text-decoration: none;
    color: var(--text);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .report-tile:hover { transform: translateY(-3px); }

  .tile-type { font-size: 0.62rem; letter-spacing: 0.14em; color: var(--gold-300); }
  .tile-title { font-family: var(--font-display); font-size: var(--text-lg); font-weight: 700; flex: 1; }
  .tile-pages { font-size: 0.62rem; color: var(--text-faint); letter-spacing: 0.1em; }

  .method-inner,
  .standards-inner {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--space-4) var(--space-6);
  }

  .method h2, .standards h2 { font-size: var(--text-2xl); }

  .method-steps { list-style: none; margin: var(--space-4) 0 0; padding: 0; display: grid; gap: var(--space-4); }

  @media (min-width: 900px) { .method-steps { grid-template-columns: repeat(2, 1fr); } }

  .method-steps li { display: flex; gap: var(--space-3); align-items: flex-start; }
  .step-num { font-size: var(--text-sm); color: var(--gold-300); padding-top: 0.2rem; }
  .method-steps h3 { font-size: var(--text-lg); margin: 0 0 var(--space-2); }
  .method-steps p { color: var(--text-muted); font-size: var(--text-sm); margin: 0; }

  .standards-grid { display: grid; grid-template-columns: 1fr; gap: var(--space-4); margin-top: var(--space-4); }
  @media (min-width: 760px) { .standards-grid { grid-template-columns: repeat(2, 1fr); } }

  .standard {
    background: var(--card-bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
  }

  .standard.will { border-left: 3px solid var(--gold-500); }
  .standard.wont { border-left: 3px solid var(--alert-red); }
  .standard-label { font-size: 0.6rem; letter-spacing: 0.14em; color: var(--text-faint); margin: 0 0 var(--space-3); }
  .standard ul { margin: 0; padding-left: 1.1rem; color: var(--text-muted); font-size: var(--text-sm); }
  .standard li { margin-bottom: 0.5rem; }
  .standards-note { color: var(--text-faint); font-size: var(--text-sm); font-style: italic; max-width: 64ch; margin-top: var(--space-4); }

  .paths { background: var(--paper); }
  .paths-inner { max-width: var(--page-max); margin: 0 auto; padding: var(--space-6) var(--space-4); }
  .paths h2 { font-size: var(--text-2xl); }

  .path-links { display: flex; flex-direction: column; gap: var(--space-2); }

  .path-links a {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--line);
  }

  .path-links a:hover { color: var(--gold-300); }
</style>
