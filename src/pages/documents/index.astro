---
// The Document Register. Every paper, kit, guide, framework, and
// newsletter issue the Foundation has ever mentioned, readable inline.
import { getCollection } from 'astro:content';
import Shell from '../../layouts/Shell.astro';

const documents = (await getCollection('documents')).sort((a, b) =>
  a.data.docNumber.localeCompare(b.data.docNumber)
);
const categories = [...new Set(documents.map((d) => d.data.category))];
---

<Shell
  title="Document Register · Solar Save Foundation"
  description="The complete public document register of the Solar Save Foundation. Every document readable in full, on this site, without downloading anything."
  surface="crisis"
>
  <div class="register">
    <header>
      <p class="eyebrow">Office of Document Control</p>
      <h1>The Document Register</h1>
      <p class="lede">
        Every document below is complete, numbered, and readable in full
        on this site. Nothing is downloaded. The Foundation considers a
        document that leaves the building a document at risk.
      </p>
    </header>

    <div class="cats" role="group" aria-label="Filter by category">
      <button class="cat mono active" data-cat="">All</button>
      {categories.map((c) => (
        <button class="cat mono" data-cat={c}>{c}</button>
      ))}
    </div>

    <ol class="doc-list">
      {documents.map((d) => (
        <li class="doc-row" data-cat={d.data.category}>
          <a href={`/documents/${d.id}`}>
            <span class="mono doc-number">{d.data.docNumber}</span>
            <span class="doc-main">
              <span class="doc-title">{d.data.title}</span>
              <span class="doc-summary">{d.data.summary}</span>
            </span>
            <span class="mono doc-badges">
              {d.data.category.toUpperCase()} · {d.data.pages}PP · READ INLINE
            </span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</Shell>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.cat');
  const rows = document.querySelectorAll<HTMLElement>('.doc-row');
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      const cat = btn.dataset.cat ?? '';
      rows.forEach((row) => {
        row.hidden = Boolean(cat) && row.dataset.cat !== cat;
      });
    });
  });
</script>

<style>
  .register {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-6) var(--space-4) var(--space-7);
  }

  h1 { font-size: var(--text-3xl); }
  .lede { font-size: var(--text-lg); color: var(--text-muted); max-width: 56ch; }

  .cats { display: flex; gap: var(--space-2); flex-wrap: wrap; margin: var(--space-4) 0 var(--space-4); }

  .cat {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    background: none;
    border: 1px solid var(--line);
    color: var(--text-muted);
    border-radius: 999px;
    padding: 0.5rem 1rem;
    cursor: pointer;
  }

  .cat:hover { border-color: var(--accent); color: var(--accent); }
  .cat.active { background: var(--gold-500); color: var(--base-950, #050d1c); border-color: var(--gold-500); }

  .doc-list { list-style: none; margin: 0; padding: 0; }

  .doc-row a {
    display: grid;
    grid-template-columns: 130px 1fr auto;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-2);
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    color: var(--text);
  }

  .doc-row a:hover .doc-title { color: var(--gold-300); }

  .doc-number { font-size: var(--text-xs); color: var(--gold-300); letter-spacing: 0.08em; }
  .doc-main { display: flex; flex-direction: column; gap: 0.15rem; }
  .doc-title { font-family: var(--font-display); font-size: var(--text-lg); font-weight: 700; transition: color var(--dur-fast) var(--ease-out); }
  .doc-summary { color: var(--text-muted); font-size: var(--text-sm); }
  .doc-badges { font-size: 0.6rem; color: var(--text-faint); letter-spacing: 0.1em; white-space: nowrap; }

  @media (max-width: 720px) {
    .doc-row a { grid-template-columns: 1fr; gap: var(--space-1); }
    .doc-badges { display: none; }
  }
</style>
