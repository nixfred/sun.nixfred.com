---
// Homepage blueprint sections 14 + 15. Newsletter (local success state
// only, the email is never stored or transmitted) and the final CTA band.
---

<section class="newsletter" data-surface="editorial">
  <div class="newsletter-inner">
    <div>
      <h2>Get the latest from 93 million miles away.</h2>
      <p>
        Monthly intelligence on the state of the Sun, delivered with the
        editorial rigor our donors have come to schedule meetings about.
      </p>
    </div>
    <form class="newsletter-form" id="newsletter-form">
      <!-- STATIC DEMO ONLY. NO NETWORK REQUESTS. The address is not
           stored, transmitted, or read after the success state. -->
      <label class="sr-only" for="newsletter-email">Email address</label>
      <input id="newsletter-email" type="email" placeholder="you@example.com" required autocomplete="off" />
      <button type="submit" class="btn-navy">Subscribe</button>
      <p class="newsletter-success mono" id="newsletter-success" hidden>
        You have been added to the preliminary communications queue.
      </p>
    </form>
  </div>
</section>

<section class="final-cta" data-surface="crisis">
  <div class="final-inner">
    <h2>4.8 billion years will be here before you know it.</h2>
    <div class="final-actions">
      <a class="btn-gold" href="/donate">Donate</a>
      <a class="btn-ghost" href="/get-involved/volunteer">Volunteer</a>
      <a class="btn-ghost" href="/get-involved/contact-congress">Contact Congress</a>
    </div>
  </div>
</section>

<script>
  // Local success state only. Nothing leaves the page.
  const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const input = form.querySelector<HTMLInputElement>('input[type="email"]');
    const success = document.getElementById('newsletter-success');
    if (input) input.value = '';
    if (success) success.hidden = false;
  });
</script>

<style>
  .newsletter {
    background: var(--paper-warm);
    color: var(--ink);
  }

  .newsletter-inner {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-6) var(--space-4);
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }

  @media (min-width: 900px) {
    .newsletter-inner { grid-template-columns: 1.2fr 1fr; }
  }

  .newsletter h2 { font-size: var(--text-2xl); }
  .newsletter p { color: var(--gray-700); margin: 0; }

  .newsletter-form { display: flex; gap: var(--space-2); flex-wrap: wrap; }

  .newsletter-form input {
    flex: 1;
    min-width: 220px;
    font: 400 var(--text-base) var(--font-sans);
    padding: 0.85rem 1rem;
    border: 1px solid var(--gray-200);
    border-radius: var(--radius);
    background: var(--card-bg);
    color: var(--ink);
  }

  .btn-navy {
    background: var(--navy-900);
    color: #fff;
    font: 700 0.9rem var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border: 0;
    padding: 0.85rem 1.5rem;
    border-radius: var(--radius);
    cursor: pointer;
  }

  .btn-navy:hover { background: var(--navy-700); }

  .newsletter-success {
    width: 100%;
    font-size: var(--text-sm);
    color: var(--gold-700);
    margin: var(--space-2) 0 0;
  }

  .final-cta {
    background:
      radial-gradient(900px 480px at 50% 120%, rgba(224, 163, 46, 0.18), transparent 65%),
      var(--navy-950);
    color: #eef1f7;
  }

  .final-inner {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-7) var(--space-4);
    text-align: center;
  }

  .final-cta h2 {
    font-size: var(--text-3xl);
    max-width: 24ch;
    margin: 0 auto var(--space-5);
  }

  .final-actions {
    display: flex;
    gap: var(--space-3);
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-gold,
  .btn-ghost {
    font: 700 0.92rem var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    padding: 0.9rem 1.6rem;
    border-radius: var(--radius);
  }

  .btn-gold { background: var(--gold-500); color: var(--navy-950); }
  .btn-gold:hover { background: var(--gold-300); color: var(--navy-950); }

  .btn-ghost { border: 1px solid #3a5580; color: #eef1f7; }
  .btn-ghost:hover { border-color: var(--gold-300); color: var(--gold-300); }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
