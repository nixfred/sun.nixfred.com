---
// THE HOMEPAGE. All 16 sections of 02_HOMEPAGE_BLUEPRINT.
// Status bar, header, and footer come from Shell. Sections 3 through 15
// are the components below, in blueprint order.
import Shell from '../layouts/Shell.astro';
import Hero from '../components/home/Hero.astro';
import UrgencyMetrics from '../components/home/UrgencyMetrics.astro';
import CampaignStatement from '../components/home/CampaignStatement.astro';
import ProgramsGrid from '../components/home/ProgramsGrid.astro';
import ImpactProof from '../components/home/ImpactProof.astro';
import DonationModule from '../components/home/DonationModule.astro';
import FeaturedStory from '../components/home/FeaturedStory.astro';
import CrisisExplainer from '../components/home/CrisisExplainer.astro';
import SponsorWall from '../components/home/SponsorWall.astro';
import NewsAndReport from '../components/home/NewsAndReport.astro';
import NewsletterAndCTA from '../components/home/NewsletterAndCTA.astro';
---

<Shell
  title="Save The Sun Foundation · The Sun Cannot Save Itself"
  description="The Save The Sun Foundation leads the global response to the solar continuity crisis. The Sun has approximately 4.8 billion years remaining. We have already wasted 4.6 billion."
  surface="crisis"
>
  <Hero />
  <UrgencyMetrics />
  <CampaignStatement />
  <ProgramsGrid />
  <ImpactProof />
  <DonationModule />
  <FeaturedStory />
  <CrisisExplainer />
  <SponsorWall />
  <NewsAndReport />
  <NewsletterAndCTA />
</Shell>
