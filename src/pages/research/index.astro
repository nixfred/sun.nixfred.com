---
// Research overview.
import { getCollection } from 'astro:content';
import Shell from '../../layouts/Shell.astro';

const reports = (await getCollection('reports')).sort((a, b) => b.data.year - a.data.year).slice(0, 3);
---

<Shell
  title="Research · Save The Sun Foundation"
  description="The research operation of the Save The Sun Foundation. Peer adjacent, methodologically ratified, and freely available."
  surface="crisis"
>
  <div class="research-overview">
    <header class="hero">
      <p class="eyebrow">Research</p>
      <h1>Science, plus the courage to schedule it.</h1>
      <p class="lede">
        The Foundation's research operation reviews the peer reviewed
        literature, confirms that it remains alarming, and publishes the
        confirmation. Our methodology is public, our findings are final,
        and our Scientific Council has never once been surprised by the
        Sun.
      </p>
    </header>

    <section class="featured-reports">
      <h2 class="mono section-label">RECENT PUBLICATIONS</h2>
      <div class="report-row">
        {reports.map((r) => (
          <a class="report-tile" href={`/reports/${r.id}`}>
            <span class="mono tile-type">{r.data.type.toUpperCase()} · {r.data.year}</span>
            <span class="tile-title">{r.data.title}</span>
            <span class="mono tile-pages">{r.data.pages} PAGES</span>
          </a>
        ))}
      </div>
    </section>

    <section class="paths" data-surface="editorial">
      <div class="paths-inner">
        <h2>Enter the record.</h2>
        <div class="path-links">
          <a href="/research/library">The Research Library, complete and filterable →</a>
          <a href="/crisis/solar-depletion">The science of solar depletion, briefing one →</a>
          <a href="/news/blog">Analysis and commentary from Foundation staff →</a>
        </div>
      </div>
    </section>
  </div>
</Shell>

<style>
  .hero {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-7) var(--space-4) var(--space-5);
  }

  h1 { font-size: var(--text-3xl); max-width: 22ch; }
  .lede { font-size: var(--text-lg); color: var(--text-muted); max-width: 58ch; }

  .featured-reports {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--space-4) var(--space-6);
  }

  .section-label {
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    color: var(--text-faint);
    margin-bottom: var(--space-3);
  }

  .report-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-4);
  }

  .report-tile {
    background: var(--card-bg);
    border: 1px solid var(--line);
    border-bottom: 3px solid var(--gold-500);
    border-radius: var(--radius);
    padding: var(--space-4);
    text-decoration: none;
    color: var(--text);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .report-tile:hover { transform: translateY(-3px); }

  .tile-type { font-size: 0.62rem; letter-spacing: 0.14em; color: var(--gold-300); }
  .tile-title { font-family: var(--font-display); font-size: var(--text-lg); font-weight: 700; flex: 1; }
  .tile-pages { font-size: 0.62rem; color: var(--text-faint); letter-spacing: 0.1em; }

  .paths { background: var(--paper); }
  .paths-inner { max-width: var(--page-max); margin: 0 auto; padding: var(--space-6) var(--space-4); }
  .paths h2 { font-size: var(--text-2xl); }

  .path-links { display: flex; flex-direction: column; gap: var(--space-2); }

  .path-links a {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--line);
  }

  .path-links a:hover { color: var(--gold-300); }
</style>
