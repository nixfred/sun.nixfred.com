---
// News and Stories landing: latest across blog and press.
import { getCollection } from 'astro:content';
import Shell from '../../layouts/Shell.astro';

const blog = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const press = (await getCollection('press')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const featured = blog[0];
---

<Shell
  title="News and Stories · Solar Save Foundation"
  description="The latest from the front line of the daytime. News, analysis, and field reporting from the Solar Save Foundation."
  surface="editorial"
>
  <div class="news-page">
    <header>
      <p class="eyebrow">News and Stories</p>
      <h1>The record of the response.</h1>
    </header>

    {featured && (
      <a class="featured" href={`/news/blog/${featured.id}`}>
        <p class="mono featured-meta">
          FEATURED · {featured.data.category.toUpperCase()} · {fmt.format(featured.data.date).toUpperCase()}
        </p>
        <h2>{featured.data.title}</h2>
        <p class="featured-excerpt">{featured.data.excerpt}</p>
      </a>
    )}

    <div class="columns">
      <section>
        <div class="col-head">
          <h2>Foundation Blog</h2>
          <a class="mono view-all" href="/news/blog">All posts →</a>
        </div>
        <ul class="list">
          {blog.slice(1, 7).map((post) => (
            <li>
              <a href={`/news/blog/${post.id}`}>
                <span class="mono item-meta">{post.data.category.toUpperCase()} · {fmt.format(post.data.date).toUpperCase()}</span>
                <span class="item-title">{post.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <div class="col-head">
          <h2>Press Releases</h2>
          <a class="mono view-all" href="/news/press">All releases →</a>
        </div>
        <ul class="list">
          {press.slice(0, 6).map((release) => (
            <li>
              <a href={`/news/press/${release.id}`}>
                <span class="mono item-meta">{fmt.format(release.data.date).toUpperCase()}</span>
                <span class="item-title">{release.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</Shell>

<style>
  .news-page {
    max-width: var(--page-wide);
    margin: 0 auto;
    padding: var(--space-6) var(--space-4) var(--space-7);
  }

  h1 { font-size: var(--text-3xl); }

  .featured {
    display: block;
    background: var(--navy-900);
    color: #eef1f7;
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    margin: var(--space-5) 0;
    text-decoration: none;
  }

  .featured:hover h2 { color: var(--gold-300); }
  .featured-meta { font-size: var(--text-xs); color: var(--gold-300); letter-spacing: 0.12em; }
  .featured h2 { font-size: var(--text-2xl); margin: var(--space-2) 0; color: #eef1f7; transition: color var(--dur-fast) var(--ease-out); }
  .featured-excerpt { color: #aab6c9; max-width: 64ch; margin: 0; }

  .columns {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 900px) {
    .columns { grid-template-columns: 1fr 1fr; }
  }

  .col-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 2px solid var(--ink);
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .col-head h2 { font-size: var(--text-xl); margin: 0; }
  .view-all { color: var(--gold-300); text-decoration: none; font-size: var(--text-xs); letter-spacing: 0.08em; }
  .view-all:hover { text-decoration: underline; }

  .list { list-style: none; margin: 0; padding: 0; }

  .list a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--gray-200);
    text-decoration: none;
    color: var(--ink);
  }

  .list a:hover .item-title { color: var(--gold-300); }
  .item-meta { font-size: 0.62rem; color: var(--gray-500); letter-spacing: 0.12em; }
  .item-title { font-family: var(--font-display); font-size: var(--text-lg); font-weight: 700; transition: color var(--dur-fast) var(--ease-out); }
</style>
