---
// FOUNDATION SCAFFOLD PAGE. Replaced by the full homepage in the
// vertical slice (02_HOMEPAGE_BLUEPRINT). Runs through Shell so the
// status bar, mega nav header, and institutional footer render for
// review on the preview branch.
import Shell from '../layouts/Shell.astro';
---

<Shell
  title="Save The Sun Foundation"
  description="The Sun cannot save itself. The Save The Sun Foundation leads the global response to the solar continuity crisis."
  surface="crisis"
>
  <div class="hold">
    <p class="eyebrow">Save The Sun Foundation</p>
    <h1>The Sun Cannot Save Itself.</h1>
    <p class="lede">
      The full digital headquarters of the Foundation is in final
      pre&#8209;launch review. Our communications team has confirmed the
      review is proceeding with appropriate urgency.
    </p>
    <p class="mono status">SITE STATUS: PRELIMINARY ALLOCATION REVIEW</p>
  </div>

  <style>
    .hold {
      min-height: 60vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
      max-width: var(--page-max);
      margin: 0 auto;
      padding: var(--space-7) var(--space-4);
    }

    h1 {
      font-size: var(--text-hero);
      max-width: 14ch;
    }

    .lede {
      font-size: var(--text-lg);
      color: var(--text-muted);
      max-width: 52ch;
    }

    .status {
      font-size: var(--text-sm);
      color: var(--accent);
      letter-spacing: 0.08em;
      margin-top: var(--space-4);
    }
  </style>
</Base>
